      <Grid Name="PronunciationPage" Grid.Row="1" Visibility="Collapsed">
       <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
       </Grid.RowDefinitions>
       <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
        <Button Name="AddPronunciationButton" Content="+  Add entry" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0" />
        <Button Name="EditPronunciationButton" Content="Edit" Margin="0,0,12,0" />
        <Button Name="RemovePronunciationButton" Content="Remove" Margin="0,0,12,0" />
        <Button Name="PronunciationUpButton" Content="Move up" Margin="0,0,12,0" />
        <Button Name="PronunciationDownButton" Content="Move down" Margin="0" />
       </StackPanel>
       <Border Grid.Row="1" Background="#E61E1A27" BorderBrush="#50485C" BorderThickness="1" CornerRadius="11" ClipToBounds="True">
        <Grid>
         <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition />
         </Grid.RowDefinitions>
         <Border Background="#991E1A27" BorderBrush="#50485C" BorderThickness="0,0,0,1" Padding="18,14">
          <StackPanel>
           <TextBlock Text="Pronunciation dictionary" FontSize="17" FontWeight="SemiBold" />
           <TextBlock Text="Separate multiple pronunciations with commas and the bridge will choose one randomly. Matching is case-insensitive." Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
          </StackPanel>
         </Border>
         <DataGrid Name="PronunciationGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserResizeRows="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow">
          <DataGrid.Columns>
           <DataGridTextColumn Header="WRITTEN TEXT" Binding="{Binding DisplayWritten}" Width="0.42*" ElementStyle="{StaticResource GridText}" />
           <DataGridTextColumn Header="SPOKEN AS / RANDOM OPTIONS" Binding="{Binding Spoken}" Width="0.58*" ElementStyle="{StaticResource GridText}" />
          </DataGrid.Columns>
         </DataGrid>
        </Grid>
       </Border>
       <Border Grid.Row="2" Background="#E61E1A27" BorderBrush="#50485C" BorderThickness="1" CornerRadius="11" Padding="16" Margin="0,12,0,0">
        <Grid>
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
         </Grid.ColumnDefinitions>
         <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
          <TextBlock Text="Preview selected entry" FontWeight="SemiBold" />
          <TextBlock Text="Choose an alias; each preview randomly picks one configured option." Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
         </StackPanel>
         <ComboBox Name="PronunciationVoiceList" Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center" />
         <Button Name="TestPronunciationButton" Grid.Column="2" Content="Test audio" Style="{StaticResource PrimaryButton}" Margin="0" VerticalAlignment="Center" />
        </Grid>
       </Border>
      </Grid>
      <ScrollViewer Name="StreamerBotPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
       <StackPanel MaxWidth="800" HorizontalAlignment="Left" Margin="0,0,10,0">
        <Border Background="#E61E1A27" BorderBrush="#50485C" BorderThickness="1" CornerRadius="12" Padding="20">
         <StackPanel>
          <TextBlock Text="Connection" FontSize="17" FontWeight="SemiBold" />
          <CheckBox Name="EnableUdpCheck" Content="Listen for Streamer.bot UDP speak requests" Margin="0,14,0,0" />
          <Grid Margin="0,14,0,0">
           <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" MinWidth="220" />
           </Grid.ColumnDefinitions>
           <StackPanel>
            <TextBlock Text="UDP port" Foreground="{StaticResource Muted}" />
            <TextBox Name="UdpBox" Margin="0,6,0,0" MinWidth="160" />
           </StackPanel>
           <StackPanel Grid.Column="2">
            <TextBlock Text="WebSocket port" Foreground="{StaticResource Muted}" />
            <TextBox Name="WsBox" Margin="0,6,0,0" MinWidth="160" />
           </StackPanel>
           <StackPanel Grid.Column="4">
            <TextBlock Text="HTTP address (actions)" Foreground="{StaticResource Muted}" />
            <TextBox Name="StreamerBotHttpUrlBox" Margin="0,6,0,0" MinWidth="220" />
           </StackPanel>
          </Grid>
          <TextBlock Text="UDP payload for Streamer.bot" Foreground="{StaticResource Muted}" Margin="0,15,0,0" />
          <TextBox Name="StreamerPayloadBox" Text="VSPEAK&#xA;%voice%&#xA;%rawInput%" Height="72" Margin="0,6,0,0" AcceptsReturn="True" FontFamily="Cascadia Mono" IsReadOnly="True" />
          <Button Name="CopyPayloadButton" Content="Copy payload" HorizontalAlignment="Left" Margin="0,12,0,0" />
         </StackPanel>
        </Border>
        <Border Background="#E61E1A27" BorderBrush="#50485C" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,14,0,0">
         <StackPanel>
          <TextBlock Text="Lifecycle actions" FontSize="17" FontWeight="SemiBold" />
          <CheckBox Name="EnableStreamerBotActionsCheck" Content="Enable lifecycle actions" Margin="0,12,0,13" />
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
           <StackPanel><TextBlock Text="Queued" Foreground="{StaticResource Muted}" /><TextBox Name="StreamerBotQueuedActionBox" Margin="0,6,0,0" /></StackPanel>
           <Button Name="TestStreamerBotQueuedButton" Grid.Column="2" Content="Test" Width="70" Margin="0,24,0,0" />
          </Grid>
          <Border Background="#801E1A27" BorderBrush="#3D3741" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,14,0,0">
           <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
             <TextBlock Text="Delay before playback" FontWeight="SemiBold" />
             <TextBlock Text="Wait after the Queued action before speaking." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,12,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="#1E1A27" BorderBrush="#50485C" BorderThickness="1" CornerRadius="7" Padding="10,5" MinWidth="62"><TextBlock Name="StreamerBotPlaybackDelayValue" Text="0.00 s" Foreground="#B6A3FF" FontWeight="SemiBold" HorizontalAlignment="Center" /></Border>
            <Slider Name="StreamerBotPlaybackDelaySlider" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource VoiceSlider}" Minimum="0" Maximum="10" TickFrequency="0.25" IsSnapToTickEnabled="True" SmallChange="0.25" LargeChange="1" Margin="0,11,0,0" />
           </Grid>
          </Border>
          <Grid Margin="0,12,0,0">
           <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
           <StackPanel><TextBlock Text="Added while speaking" Foreground="{StaticResource Muted}" /><TextBox Name="StreamerBotQueueAddedActionBox" Margin="0,6,0,0" /></StackPanel>
           <Button Name="TestStreamerBotQueueAddedButton" Grid.Column="2" Content="Test" Width="70" Margin="0,24,0,0" />
          </Grid>
          <Grid Margin="0,12,0,0">
           <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
           <StackPanel><TextBlock Text="Playback started" Foreground="{StaticResource Muted}" /><TextBox Name="StreamerBotPlayingActionBox" Margin="0,6,0,0" /></StackPanel>
           <Button Name="TestStreamerBotPlayingButton" Grid.Column="2" Content="Test" Width="70" Margin="0,24,0,0" />
          </Grid>
          <Grid Margin="0,12,0,0">
           <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
           <StackPanel><TextBlock Text="Queue finished" Foreground="{StaticResource Muted}" /><TextBox Name="StreamerBotFinishedActionBox" Margin="0,6,0,0" /></StackPanel>
           <Button Name="TestStreamerBotFinishedButton" Grid.Column="2" Content="Test" Width="70" Margin="0,24,0,0" />
          </Grid>
          <Border Background="#801E1A27" BorderBrush="#3D3741" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,14,0,0">
           <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="Delay after queue finishes" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border Grid.Column="1" Background="#1E1A27" BorderBrush="#50485C" BorderThickness="1" CornerRadius="7" Padding="10,5" MinWidth="62"><TextBlock Name="StreamerBotFinishedDelayValue" Text="0.00 s" Foreground="#B6A3FF" FontWeight="SemiBold" HorizontalAlignment="Center" /></Border>
            <Slider Name="StreamerBotFinishedDelaySlider" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource VoiceSlider}" Minimum="0" Maximum="10" TickFrequency="0.25" IsSnapToTickEnabled="True" SmallChange="0.25" LargeChange="1" Margin="0,11,0,0" />
           </Grid>
          </Border>
          <TextBlock Text="Action variables: %ttsState%, %ttsId%, %ttsText%, %ttsAlias%, %ttsVoice%, %ttsSource%, %ttsUser%, %ttsDuration%" Foreground="{StaticResource Muted}" Margin="0,13,0,0" TextWrapping="Wrap" FontSize="11" />
          <Button Name="SaveStreamerBotButton" Content="Save" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0" />
         </StackPanel>
        </Border>
        <Border Background="#E61E1A27" BorderBrush="#50485C" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,14,0,0">
         <StackPanel>
          <TextBlock Text="Queue controls" FontSize="17" FontWeight="SemiBold" />
          <TextBlock Text="Choose a command, then copy its payload into a Streamer.bot UDP Broadcast action on the port shown above." Foreground="{StaticResource Muted}" Margin="0,4,0,15" TextWrapping="Wrap" />
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="14" /><ColumnDefinition /></Grid.ColumnDefinitions>
           <StackPanel><TextBlock Text="Action" Foreground="{StaticResource Muted}" /><ComboBox Name="QueueControlCommandBox" Margin="0,6,0,0"><ComboBoxItem Content="Pause" Tag="pause" /><ComboBoxItem Content="Resume" Tag="resume" /><ComboBoxItem Content="Skip current" Tag="skip" /><ComboBoxItem Content="Remove item" Tag="remove" /><ComboBoxItem Content="Move item up" Tag="moveup" /><ComboBoxItem Content="Move item down" Tag="movedown" /><ComboBoxItem Content="Clear queue" Tag="clear" /></ComboBox></StackPanel>
           <StackPanel Grid.Column="2"><TextBlock Text="UDP payload" Foreground="{StaticResource Muted}" /><TextBox Name="QueueControlPayloadBox" Height="58" Margin="0,6,0,0" AcceptsReturn="True" IsReadOnly="True" FontFamily="Cascadia Mono" VerticalContentAlignment="Center" /></StackPanel>
          </Grid>
          <TextBlock Name="QueueControlHint" Foreground="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button Name="CopyQueueControlButton" Content="Copy payload" Style="{StaticResource PrimaryButton}" /><Button Name="TestQueueControlButton" Content="Test action" Margin="0" /></StackPanel>
         </StackPanel>
        </Border>
       </StackPanel>
      </ScrollViewer>
      <ScrollViewer Name="VoiceStudioPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
       <StackPanel MaxWidth="720" HorizontalAlignment="Left" Margin="0,0,10,0">
        <Border Background="#E61E1A27" BorderBrush="#50485C" BorderThickness="1" CornerRadius="12" Padding="20">
         <StackPanel>
          <TextBlock Text="VoiceStudio" FontSize="17" FontWeight="SemiBold" />
          <TextBlock Text="Local cloned voices" Foreground="{StaticResource Muted}" Margin="0,4,0,16" />
          <TextBlock Text="Service address" Foreground="{StaticResource Muted}" />
          <TextBox Name="UrlBox" Margin="0,6,0,14" />
          <Grid>
           <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="160" />
           </Grid.ColumnDefinitions>
           <StackPanel>
            <TextBlock Text="API key" Foreground="{StaticResource Muted}" />
            <TextBox Name="KeyBox" Margin="0,6,0,0" />
           </StackPanel>
           <StackPanel Grid.Column="2">
            <TextBlock Text="Timeout (sec)" Foreground="{StaticResource Muted}" />
            <TextBox Name="RequestTimeoutBox" Margin="0,6,0,0" />
           </StackPanel>
          </Grid>
          <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
           <Button Name="SaveVoiceStudioButton" Content="Save" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0" />
           <Button Name="TestVoiceStudioButton" Content="Test connection" Margin="0" />
          </StackPanel>
         </StackPanel>
        </Border>
       </StackPanel>
      </ScrollViewer>
      <ScrollViewer Name="PollyPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
       <StackPanel MaxWidth="720" HorizontalAlignment="Left" Margin="0,0,10,0">
        <Border Background="#E61E1A27" BorderBrush="#50485C" BorderThickness="1" CornerRadius="12" Padding="20">
         <StackPanel>
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
           <StackPanel>
            <TextBlock Text="Amazon Polly" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="Cloud TTS voices from AWS" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
           </StackPanel>
           <CheckBox Name="PollyEnabledCheck" Grid.Column="1" Content="Enabled" VerticalAlignment="Center" />
          </Grid>
          <TextBlock Text="1. Enter your AWS credentials" FontSize="15" FontWeight="SemiBold" Margin="0,20,0,0" />
          <TextBlock Text="Create an IAM access key with permission to use Amazon Polly, then paste both values below." Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
          <Grid Margin="0,14,0,0">
           <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
           <StackPanel>
            <TextBlock Text="Access Key ID" Foreground="{StaticResource Muted}" />
            <PasswordBox Name="PollyAccessKeyBox" Margin="0,6,0,0" PasswordChar="●" />
           </StackPanel>
           <StackPanel Grid.Column="2">
            <TextBlock Text="Secret Access Key" Foreground="{StaticResource Muted}" />
            <PasswordBox Name="PollySecretKeyBox" Margin="0,6,0,0" PasswordChar="●" />
           </StackPanel>
          </Grid>
          <TextBlock Name="PollyCredentialStatus" Text="No keys saved yet" Foreground="{StaticResource Muted}" Margin="0,9,0,0" />
          <TextBlock Text="2. Choose the region where Polly is enabled" FontSize="15" FontWeight="SemiBold" Margin="0,20,0,0" />
          <Grid Margin="0,10,0,0">
           <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
           <StackPanel>
            <TextBlock Text="AWS region" Foreground="{StaticResource Muted}" />
            <ComboBox Name="PollyRegionBox" Margin="0,6,0,0" IsEditable="True">
             <ComboBoxItem Content="us-east-1" /><ComboBoxItem Content="us-east-2" /><ComboBoxItem Content="us-west-1" /><ComboBoxItem Content="us-west-2" />
             <ComboBoxItem Content="eu-west-1" /><ComboBoxItem Content="eu-west-2" /><ComboBoxItem Content="eu-central-1" />
             <ComboBoxItem Content="ap-northeast-1" /><ComboBoxItem Content="ap-southeast-1" /><ComboBoxItem Content="ap-southeast-2" />
            </ComboBox>
           </StackPanel>
           <StackPanel Grid.Column="2">
            <TextBlock Text="AWS profile (advanced, optional)" Foreground="{StaticResource Muted}" />
            <TextBox Name="PollyProfileBox" Margin="0,6,0,0" />
           </StackPanel>
          </Grid>
          <Border Background="#66282231" CornerRadius="8" Padding="12" Margin="0,16,0,0">
           <TextBlock Text="Your keys are encrypted for your Windows account and stay on this PC. Leave the key fields blank to keep the saved credentials." Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
          </Border>
          <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
           <Button Name="SavePollyButton" Content="Save credentials" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0" />
           <Button Name="TestPollyButton" Content="Test &amp; load voices" Margin="0,0,12,0" />
           <Button Name="ClearPollyCredentialsButton" Content="Clear keys" Margin="0" />
          </StackPanel>
         </StackPanel>
        </Border>
       </StackPanel>
      </ScrollViewer>
      <ScrollViewer Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
       <StackPanel MaxWidth="800" HorizontalAlignment="Left" Margin="0,0,10,0">
        <Border Background="#E61E1A27" BorderBrush="#50485C" BorderThickness="1" CornerRadius="12" Padding="20">
         <StackPanel>
          <TextBlock Text="Audio" FontSize="17" FontWeight="SemiBold" />
          <Grid Margin="0,16,0,0">
           <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="16" />
            <ColumnDefinition />
           </Grid.ColumnDefinitions>
           <StackPanel>
            <TextBlock Text="Stream output" Foreground="{StaticResource Muted}" />
            <ComboBox Name="OutputDeviceBox" Margin="0,6,0,0" />
           </StackPanel>
           <StackPanel Grid.Column="2">
            <TextBlock Text="Preview / test output" Foreground="{StaticResource Muted}" />
            <ComboBox Name="PreviewDeviceBox" Margin="0,6,0,0" />
           </StackPanel>
          </Grid>
          <TextBlock Text="Export folder" Foreground="{StaticResource Muted}" Margin="0,15,0,0" />
          <Grid Margin="0,6,0,0">
           <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
           </Grid.ColumnDefinitions>
           <TextBox Name="VoiceSaveFolderBox" VerticalContentAlignment="Center" />
           <Button Name="BrowseVoiceFolderButton" Grid.Column="1" Content="Browse..." Margin="12,0,0,0" />
          </Grid>
         </StackPanel>
        </Border>
        <Border Background="#E61E1A27" BorderBrush="#50485C" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,14,0,0">
         <StackPanel>
          <TextBlock Text="Local API" FontSize="17" FontWeight="SemiBold" />
          <TextBlock Text="HTTP port used by VoxRelay itself. Restart after changing." Foreground="{StaticResource Muted}" Margin="0,4,0,15" />
          <StackPanel Width="220" HorizontalAlignment="Left">
           <TextBlock Text="HTTP port" Foreground="{StaticResource Muted}" />
           <TextBox Name="HttpBox" Margin="0,6,0,0" Width="220" />
          </StackPanel>
         </StackPanel>
        </Border>
        <Border Background="#E61E1A27" BorderBrush="#50485C" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,14,0,0">
         <StackPanel>
          <TextBlock Text="Limits" FontSize="17" FontWeight="SemiBold" />
          <Grid Margin="0,16,0,0">
           <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="14" />
            <ColumnDefinition />
            <ColumnDefinition Width="14" />
            <ColumnDefinition />
           </Grid.ColumnDefinitions>
           <StackPanel>
            <TextBlock Text="Max characters" Foreground="{StaticResource Muted}" />
            <TextBox Name="MaxCharactersSettingBox" Margin="0,6,0,0" />
           </StackPanel>
           <StackPanel Grid.Column="2">
            <TextBlock Text="Max queue size" Foreground="{StaticResource Muted}" />
            <TextBox Name="MaxQueueSettingBox" Margin="0,6,0,0" />
           </StackPanel>
           <StackPanel Grid.Column="4">
            <TextBlock Text="History entries" Foreground="{StaticResource Muted}" />
            <TextBox Name="HistoryLimitBox" Margin="0,6,0,0" />
           </StackPanel>
          </Grid>
         </StackPanel>
        </Border>
        <Border Background="#E61E1A27" BorderBrush="#50485C" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,14,0,0">
         <StackPanel>
          <TextBlock Text="Window" FontSize="17" FontWeight="SemiBold" />
          <CheckBox Name="MinimizeToTrayCheck" Content="Minimize to system tray" Margin="0,14,0,0" />
          <TextBlock Text="Keeps a tray icon while VoxRelay is running. Minimize hides the window; click the tray icon to restore. Right-click the icon to Exit." Foreground="{StaticResource Muted}" Margin="27,6,0,0" TextWrapping="Wrap" FontSize="11" />
         </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
         <Button Name="SaveButton" Content="Save" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0" />
         <Button Name="TestConnectionButton" Content="Refresh devices" Margin="0" />
        </StackPanel>
       </StackPanel>
      </ScrollViewer>
      <Border Name="ActivityPage" Grid.Row="1" Visibility="Collapsed" Background="#E615131D" BorderBrush="#50485C" BorderThickness="1" CornerRadius="11" Padding="8">
       <ListBox Name="ActivityList" Background="Transparent" Foreground="#F6F3FA" BorderThickness="0" FontFamily="Cascadia Mono" FontSize="12" />
      </Border>
      <Border Grid.Row="2" BorderBrush="#50485C" BorderThickness="1" CornerRadius="11" Padding="13,11" Margin="0,15,0,0" Background="#1E1A27">
       <Grid>
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="Auto" />
         <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Ellipse Name="BottomStatusDot" Width="7" Height="7" Fill="#B9B2C2" VerticalAlignment="Center" />
        <TextBlock Name="BottomStatus" Grid.Column="1" Text="Initializing bridge..." Foreground="#F6F3FA" Margin="10,0,0,0" />
       </Grid>
      </Border>
     </Grid>
    </Grid>
   </Grid>
  </Grid>
 </Border>
