   <Setter Property="BorderThickness" Value="0" />
   <Setter Property="Foreground" Value="#F6F3FA" />
  </Style>
  <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="HorizontalContentAlignment" Value="Left" />
   <Setter Property="Background" Value="Transparent" />
   <Setter Property="BorderThickness" Value="0" />
   <Setter Property="Padding" Value="16,12" />
   <Setter Property="MinHeight" Value="0" />
   <Setter Property="Margin" Value="10,3" />
   <Setter Property="Foreground" Value="#F6F3FA" />
  </Style>
  <Style x:Key="SelectedNavButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
   <Setter Property="Background" Value="#331E1A27" />
   <Setter Property="Foreground" Value="#B6A3FF" />
  </Style>
  <Style x:Key="NavSectionButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
