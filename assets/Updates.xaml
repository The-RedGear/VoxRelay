<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="YapLoq updates" Width="640" Height="470" MinWidth="500" MinHeight="330" WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResizeWithGrip" Background="Transparent" Foreground="#EEEAF4" ShowInTaskbar="False">
 <Border Background="#15131D" BorderBrush="#50485C" BorderThickness="1" CornerRadius="12">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Name="UpdateTitleBar" Background="#1B1824" BorderBrush="#3D3748" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0">
    <Grid Margin="16,0,8,0">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Name="UpdateTitleDragRegion" Orientation="Horizontal" VerticalAlignment="Center">
      <Image Name="UpdateBrandLogo" Width="20" Height="20" Margin="0,0,9,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
      <TextBlock Text="YapLoq updates" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
     </StackPanel>
     <Button Name="UpdateClose" Grid.Column="1" Width="34" Height="30" Padding="0" Background="Transparent" BorderThickness="0" ToolTip="Close" AutomationProperties.Name="Close updates">
      <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
      <Viewbox Width="12" Height="12"><Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Data="M18.3 5.71 12 12l6.3 6.29-1.42 1.42L10.59 13.4 4.29 19.71 2.87 18.29 9.17 12 2.87 5.71 4.29 4.29 10.59 10.6 16.88 4.29z"/></Viewbox>
     </Button>
    </Grid>
   </Border>
   <Grid Grid.Row="1" Margin="24,22,24,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <TextBlock Name="UpdateHeading" Text="YapLoq updates" FontSize="23" FontWeight="SemiBold"/>
     <TextBlock Name="UpdateVersions" Margin="0,7,0,0" Foreground="#B9B2C2"/>
     <TextBlock Name="UpdateMessage" Margin="0,12,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    <ProgressBar Name="UpdateProgress" Grid.Row="1" Height="5" Margin="0,14,0,0" Maximum="100" Foreground="#B6A3FF" Visibility="Collapsed"/>
    <Border Name="UpdateNotesCard" Grid.Row="2" Margin="0,18,0,14" Padding="14" Background="#211D2B" BorderBrush="#50485C" BorderThickness="1" CornerRadius="10">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock Text="What’s new" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
      <TextBox Name="UpdateNotes" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" BorderThickness="0" Background="Transparent" Foreground="#EEEAF4" Padding="0" Text="Patch notes will appear here when a release is published."/>
     </Grid>
    </Border>
    <TextBlock Name="UpdateSafetyNote" Grid.Row="3" Text="Settings are backed up automatically before installation." Foreground="#B9B2C2" TextWrapping="Wrap" Margin="0,0,0,14" Visibility="Collapsed"/>
    <DockPanel Grid.Row="4" LastChildFill="False">
     <Button Name="UpdateSavePackage" Content="Save package…" DockPanel.Dock="Left" Visibility="Collapsed"/>
     <Button Name="UpdatePrimary" Content="Check for updates" DockPanel.Dock="Right" FontWeight="SemiBold"/>
    </DockPanel>
   </Grid>
  </Grid>
 </Border>
</Window>
