<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" CornerRadius="11" Background="#E61E1A27" BorderBrush="#50485C" BorderThickness="1" Padding="16,12" Margin="0,14,0,0">
 <Expander Name="ProfanityExpander" Header="Profanity" IsExpanded="False" Style="{DynamicResource SettingsExpander}">
 <StackPanel Margin="4,8,4,4">
  <TextBlock Text="Replace a word, remove it, or block the message. Only whole words match." Foreground="#B9B2C2" TextWrapping="Wrap" Margin="0,4,0,12" />
  <WrapPanel><CheckBox Name="Enabled" Content="Filter profanity" Margin="0,0,24,12"/><CheckBox Name="ShowWords" Content="Show words in the app" Margin="0,0,0,12"/></WrapPanel>
  <Border CornerRadius="10" BorderBrush="#50485C" BorderThickness="1" Padding="4">
   <DataGrid Name="Words" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" SelectionMode="Single" SelectionUnit="FullRow" MinHeight="180" MaxHeight="340" RowHeight="46" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <DataGrid.Columns>
     <DataGridTemplateColumn Header="ON" Width="56"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="WORD" Binding="{Binding DisplayWord}" Width="*" IsReadOnly="True"/>
     <DataGridTextColumn Header="ACTION" Binding="{Binding ActionLabel}" Width="120" IsReadOnly="True"/>
     <DataGridTextColumn Header="REPLACEMENT" Binding="{Binding DisplayReplacement}" Width="*" IsReadOnly="True"/>
     <DataGridTextColumn Header="FORMS" Binding="{Binding FormCount}" Width="86" IsReadOnly="True"/>
    </DataGrid.Columns>
   </DataGrid>
  </Border>
  <WrapPanel Margin="0,12,0,0"><Button Name="Add" Content="+ Add word"/><Button Name="Edit" Content="Edit"/><Button Name="Remove" Content="Remove"/><Button Name="All" Content="Enable all"/><Button Name="None" Content="Disable all"/><Button Name="SaveProfanity" Content="Save profanity"/></WrapPanel>
  <TextBlock Text="Save to apply changes. Hiding words masks matching text in History, Queue, Activity and the player; it does not change saved audio or files." Foreground="#B9B2C2" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/>
 </StackPanel>
 </Expander>
</Border>
