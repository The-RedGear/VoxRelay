<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Profanity rule" Width="580" Height="670" WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="#F6F3FA" ResizeMode="NoResize" ShowInTaskbar="False">
 <Border Background="#15131D" CornerRadius="16" BorderBrush="#50485C" BorderThickness="1">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Name="TitleBar" Background="Transparent" Margin="22,16"><TextBlock Text="Profanity rule" FontWeight="SemiBold"/><Button Name="Close" Content="×" HorizontalAlignment="Right" Margin="0" Padding="10,2"/></Grid>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,8,24,12">
    <CheckBox Name="ShowWords" Content="Show words while editing" Margin="0,0,0,16"/>
    <TextBlock Text="Word or phrase" Margin="0,0,0,6"/><PasswordBox Name="WordHidden"/><TextBox Name="Word" Visibility="Collapsed"/>
    <TextBlock Text="Other forms (comma separated)" Margin="0,16,0,6"/><PasswordBox Name="VariantsHidden"/><TextBox Name="Variants" Visibility="Collapsed"/>
    <CheckBox Name="MatchVariants" Content="Include these other forms" IsChecked="True" Margin="0,12,0,16"/>
    <TextBlock Text="Action" Margin="0,0,0,6"/><ComboBox Name="Action"><ComboBoxItem Content="Replace" Tag="replace"/><ComboBoxItem Content="Remove word" Tag="remove"/><ComboBoxItem Content="Block message" Tag="block"/></ComboBox>
    <TextBlock Text="Say instead" Margin="0,16,0,6"/><PasswordBox Name="ReplacementHidden"/><TextBox Name="Replacement" Visibility="Collapsed"/>
    <TextBlock Text="For random alternatives, separate replacements with commas. Leave empty for silence." Foreground="#B9B2C2" TextWrapping="Wrap" Margin="0,8,0,0"/>
    <TextBlock Name="Error" Foreground="#E4AABE" TextWrapping="Wrap" Margin="0,12,0,0"/>
   </StackPanel></ScrollViewer>
   <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,16"><Button Name="Cancel" Content="Cancel" Margin="0,0,12,0"/><Button Name="Save" Content="Save word" Margin="0"/></StackPanel>
  </Grid>
 </Border>
</Window>
