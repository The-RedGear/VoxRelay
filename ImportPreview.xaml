<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="640" Height="520" WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResizeWithGrip" AllowsTransparency="True" Background="Transparent" Foreground="#F6F3FA" MinWidth="500" MinHeight="350">
 <Border Background="#15131D" BorderBrush="#50485C" BorderThickness="1" CornerRadius="13">
  <Grid><Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Name="PreviewTitleBar" Background="#1E1A27" CornerRadius="13,13,0,0" Padding="20,0"><Grid><TextBlock Name="PreviewTitle" Text="Import preview" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Name="PreviewClose" Content="X" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Margin="0"/></Grid></Border>
   <Grid Grid.Row="1" Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Name="PreviewNote" TextWrapping="Wrap" Foreground="#B9B2C2" Margin="0,0,0,16"/><ListBox Name="PreviewList" Grid.Row="1" Background="#1E1A27" Foreground="#F6F3FA" BorderBrush="#50485C" BorderThickness="1" Padding="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/></Grid>
   <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,0,24,24"><Button Name="PreviewCancel" Content="Cancel" Margin="0,0,12,0"/><Button Name="PreviewImport" Content="Import" Margin="0"/></StackPanel>
  </Grid>
 </Border>
</Window>
